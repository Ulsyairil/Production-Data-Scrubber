<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>data-scrubber</AssemblyName>
    <RootNamespace>ProductionDataScrubber.Cli</RootNamespace>
    <PackageId>ulsyairil.ProductionDataScrubber.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>ulsyairil</Authors>
    <Description>Clone a production database into a local database, scrub PII per declarative policy, and preserve foreign key integrity.</Description>
    <PackageTags>scrubber;anonymize;pii;gdpr;database;clone;dotnet-tool;cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>data-scrubber</ToolCommandName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.15" />
    <ProjectReference Include="../ProductionDataScrubber.Core/ProductionDataScrubber.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
